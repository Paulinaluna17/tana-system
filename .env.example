# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pegá-acá-la-anon-public-key
# ¡Secreta! Solo en el servidor / Vercel. Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=pegá-acá-la-service-role-key

# --- App ---
APP_URL=http://localhost:3000
# Texto largo y aleatorio. Vercel Cron lo manda como "Authorization: Bearer ..."
CRON_SECRET=cambiá-esto-por-un-texto-largo-y-secreto
# Emails de las socias de Tana (separados por coma). Al entrar, quedan como admin automáticamente.
TANA_ADMIN_EMAILS=socia1@tana.studio,socia2@tana.studio

# --- Emails (opcional). Sin esto, las notificaciones quedan solo dentro de la app. ---
RESEND_API_KEY=
EMAIL_FROM="Tana Studio <hola@tu-dominio.com>"
